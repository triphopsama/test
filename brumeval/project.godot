; Prototype de Brumeval (Godot 4.3+)

config_version=5

[application]

config/name="Brumeval (prototype)"
config/description="Le village de départ, en temps réel."
run/main_scene="res://scenes/monde.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Horloge="*res://scripts/horloge.gd"
Illustrations="*res://scripts/illustrations.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=1
